# Server-side only. Never commit .env and never expose these to the browser.
# Without a key the app runs in clearly-labeled DEMO MODE.
ANTHROPIC_API_KEY=

# Optional
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_EFFORT=medium              # low | medium | high | xhigh | max
# AI_FALLBACKS=on               # server-side refusal fallback; set "off" on non-Claude-API endpoints
# AI_REQUESTS_PER_MINUTE=10     # per IP, for /api/generate and /api/revise
# DEMO_MODE=1                   # force demo mode even when a key is set
# PORT=8787
# DATA_FILE=data/playbooks.json
